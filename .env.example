# --- Firebase Client (public, NEXT_PUBLIC_*) ---
# Nilai ini BOLEH publik (dibatasi via Firebase Console > App Check / API restrictions),
# tapi JANGAN paste nilai asli project ke file ini bila repo publik — pakai placeholder.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza_REDACTED_GANTI_DENGAN_MILIKMU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=namaproject.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=namaproject
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=namaproject.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Firebase Admin (SERVER ONLY, jangan pakai prefix NEXT_PUBLIC_) ---
# Ambil dari: Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=namaproject
FIREBASE_ADMIN_CLIENT_EMAIL=
# Satu baris, biarkan \n literal: "-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=
# Opsional, default = NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
# FIREBASE_STORAGE_BUCKET=namaproject.firebasestorage.app

# --- Admin allowlist (WAJIB diisi; kosong = login admin ditolak) ---
# Daftar email admin, pisahkan koma.
ADMIN_EMAILS=admin@sekolah.id

# --- Cloudinary (upload gambar Berita + Galeri, unsigned preset; folder berita/galeri) ---
# WAJIB: kunci preset di Cloudinary Console — folder "berita"/"galeri" saja,
# max 5MB, format jpg/png/webp. Preset terbuka = siapa pun bisa mengisi storage-mu.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Domain resmi (metadata, canonical, sitemap, robots, Open Graph) ---
NEXT_PUBLIC_SITE_URL=https://sman1lumajang.sch.id
